# ==========================================
# EC2 Deployment Configuration
# ==========================================
# The Elastic IP or public hostname of your EC2 instance
EC2_HOST=

# SSH username (typically 'ubuntu' on Ubuntu AMIs)
EC2_USER=ubuntu

# Path to your EC2 SSH private key (.pem file)
EC2_KEY_PATH=~/.ssh/your-key.pem

# Domain pointing to the EC2 Elastic IP
DOMAIN=tracker.holbox.ai

# Admin contact email for Let's Encrypt TLS certificate
ADMIN_EMAIL=admin@holbox.ai

# ==========================================
# Firebase Google SSO Configuration
# ==========================================
FIREBASE_PROJECT_ID=projecttracker-17e6d
FIREBASE_API_KEY=AIzaSyBlhlDv10wzSoOPC5f2PCRs-C8SzQuqWDk
FIREBASE_AUTH_DOMAIN=tracker.holbox.ai
FIREBASE_STORAGE_BUCKET=projecttracker-17e6d.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=615565232205
FIREBASE_APP_ID=1:615565232205:web:0ae8e33669a5761dfe7404
FIREBASE_MEASUREMENT_ID=G-LRQM9LRXHH

ALLOWED_GOOGLE_DOMAINS=holbox.ai,holbox.com

# ==========================================
# Email notifications (optional)
# ==========================================
# Off unless SMTP_HOST and SMTP_FROM are both set. With them blank the app
# behaves exactly as before and queues notifications for the moment it is
# configured -- nothing is lost and nothing is required to run locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Covex-Board <tracker@holbox.ai>
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
# Used for the "Open it" link in each message.
APP_BASE_URL=https://tracker.holbox.ai
